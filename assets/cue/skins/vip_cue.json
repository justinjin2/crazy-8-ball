  "painter": "mix",
  "note": "Black and gold: OpenAI on all four long panels (black lacquer with fine gold swirls and a thin iridescent line on the shaft; gold art-deco diamond frames holding holographic rainbow gems on the forearm and sleeve; a black quilted grip with small gold stars), a gold collar, one white glowing ring whose glow a script turns round the rainbow (your VIP rainbow), a black end with a gold crown emblem on its face. It sits below Chroma.",
  "ai": {
    "shaft_tile": {
      "refs": [
        "shaft",
        "full"
      ],
      "size": "1536x768",
      "prompt": "Glossy black lacquer (#0E0E12) with fine flowing polished gold lines (#D4AF37) that swirl gently along the length, one thin iridescent rainbow line (red, yellow, green, blue, violet) winding beside them, and a few tiny gold four-point star sparkles. Elegant, premium. No text, no logos, no other shapes."
    },
    "shaft_top": {
      "refs": [
        "shaft",
        "full"
      ],
      "prompt": "Glossy black lacquer (#0E0E12) with fine flowing polished gold lines (#D4AF37), a thin iridescent rainbow line winding beside them and tiny gold star sparkles, growing a little richer toward the right edge. No text, no logos."
    },
    "forearm": {
      "refs": [
        "closeup",
        "forearm",
        "full"
      ],
      "take": 2,
      "prompt": "Photorealistic and glossy, with real reflections and highlights, covering the whole image from the very top to the very bottom (no plain bands): deep black piano lacquer (#0E0E12) with bold art-deco frames of shining polished gold (#D4AF37, bright highlights, dark gold shadows): long pointed diamond shapes nested inside each other, with thin blue lines between the gold, each frame holding a faceted crystal gem with iridescent holographic rainbow gradients and white glints (not flat colours); tiny gold star sparkles between them. Luxurious, like jewellery. No text, no logos. The two thin strips at the far left are the joint collar: paint them polished gold (#D4AF37)."
    },
    "butt": {
      "refs": [
        "closeup",
        "butt",
        "full"
      ],
      "take": 2,
      "zones_px": [
        68,
        920,
        1323
      ],
      "prompt": "Left thin strip (the ring): plain white (#FFFFFF). The wrap (from the ring to the next zone line): black quilted leather (#101014) in a fine diamond pattern with a small gold four-point star (#D4AF37) in every few diamonds. The butt sleeve (between the two zone lines on the right): photorealistic glossy black piano lacquer with a shining polished gold band at each end and a large art-deco frame of polished gold on the middle row (nested diamond outlines with thin blue lines) holding a faceted crystal gem with iridescent holographic rainbow gradients and white glints (not flat colours). The very thin strip at the far right: plain black. No text, no logos."
    }
  },
