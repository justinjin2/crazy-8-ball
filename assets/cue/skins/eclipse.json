      "size": "1536x768",
      "prompt": "Glossy black obsidian (#050505) twisted with long spiral ribbons of polished black chrome and dark silver (#6E737C) that wind along the length, and one thin bright molten-gold line (#FFB300) with small glowing cracks winding between them. Luxurious, dark, polished. No text, no logos, no other shapes."
    },
    "shaft_top": {
      "refs": [
        "shaft",
        "full"
      ],
      "prompt": "Glossy black obsidian (#050505) twisted with spiral ribbons of polished black chrome and dark silver (#6E737C), with a thin molten-gold line (#FFB300) and glowing gold cracks winding between them, growing richer toward the right edge. No text, no logos."
    },
    "forearm": {
      "refs": [
        "closeup",
        "forearm",
        "full"
      ],
      "prompt": "Twisting ribbons of glossy black obsidian (#050505) and polished chrome (#C9CDD4) spiralling along the forearm, veined with bright molten gold (#FFB300) that glows in the cracks and along the ribbon edges. Luxurious and dark. No spheres, no text, no logos. The two thin strips at the far left are the joint collar: paint them polished chrome (#C9CDD4) with a gold band (#E3A21A)."
    },
    "butt": {
      "refs": [
        "closeup",
        "butt",
