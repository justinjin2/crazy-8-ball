  "painter": "mix",
  "note": "Black obsidian with a molten-gold corona line: OpenAI panels on the whole cue (a glossy black obsidian shaft twisted with black-chrome spiral ribbons and one molten-gold line winding along it, a forearm of twisting obsidian and chrome ribbons veined with molten gold, a black engraved grip with gold cracks, a black sleeve with gold bands), a chrome collar with gold bands, a gold ring, a black end; the molten gold glows. The 3D piece (pieces/eclipse): a floating total eclipse past the butt: a glossy black sphere held by a black cup with gold rings and four slender gold prongs, two thin glowing orbit rings precessing round it, a small cratered silver moon orbiting it, obsidian shards drifting round the mount. The corona is camera-facing particles centred on the sphere, so it sits on its outline from every side.",
  "ai": {
    "shaft_tile": {
      "refs": [
        "shaft",
        "full"
      ],
      "size": "1536x768",
      "prompt": "Glossy black obsidian (#050505) twisted with long spiral ribbons of polished black chrome and dark silver (#6E737C) that wind along the length, and one thin bright molten-gold line (#FFB300) with small glowing cracks winding between them. Luxurious, dark, polished. No text, no logos, no other shapes."
    },
    "shaft_top": {
      "refs": [
        "shaft",
        "full"
      ],
      "prompt": "Glossy black obsidian (#050505) twisted with spiral ribbons of polished black chrome and dark silver (#6E737C), with a thin molten-gold line (#FFB300) and glowing gold cracks winding between them, growing richer toward the right edge. No text, no logos."
    },
    "forearm": {
      "refs": [
        "closeup",
        "forearm",
        "full"
      ],
      "prompt": "Twisting ribbons of glossy black obsidian (#050505) and polished chrome (#C9CDD4) spiralling along the forearm, veined with bright molten gold (#FFB300) that glows in the cracks and along the ribbon edges. Luxurious and dark. No spheres, no text, no logos. The two thin strips at the far left are the joint collar: paint them polished chrome (#C9CDD4) with a gold band (#E3A21A)."
    },
    "butt": {
      "refs": [
        "closeup",
        "butt",
        "full"
      ],
      "prompt": "Left thin strip (the ring): polished gold (#E3A21A). The wrap (from the ring to the next zone line): a black grip deeply engraved with an ornate carved filigree pattern (#0A0A0A) with a few thin glowing molten-gold cracks (#FFB300). The butt sleeve (between the two zone lines on the right): glossy black obsidian with polished gold bands (#E3A21A) at both ends and a thin molten-gold line. The very thin strip at the far right: plain black. No spheres, no text, no logos."
    }
