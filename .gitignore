# macOS
.DS_Store

# Studio lock/backup files next to the place
place/*.lock
place/*.bak
place/*_autosave*

# Generated by tooling
sourcemap.json
roblox.yml
roblox.toml
.lune/

# Type definitions downloaded for luau-lsp (see tools/lint.sh)
tools/globalTypes*.d.luau

# Blender autosave backups
*.blend1

# Build residue from asset pipelines (never commit)
assets/**/scripts/*.log
assets/**/bake_cache/
assets/**/*_preflight.json
assets/**/blender_sample.txt
assets/**/mcp_tools.json
assets/**/renders/checkpoint_*.png
assets/**/checkpoints/
__pycache__/

# Table package: downloaded texture sources and 4K masters are rebuilt from Sources.json / seeds
assets/table/sources/*/
assets/table/textures/masters/

# Rooftop map: the gray-box data, generated by assets/map/gen_graybox.py for Rojo to sync
src/server/MapData/GrayBox.json
