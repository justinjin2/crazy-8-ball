-- Writes tools/economy_config.json: every number tools/economy_model.py needs, read straight
-- from src/shared/Config.luau (and the cue catalog's counts), so the model never keeps copies.
--
-- Run from the repo root:  lune run tools/export_economy.luau
-- (tools/economy_model.py runs it by itself when the JSON is missing or older than Config.)

local fs = require("@lune/fs")
local serde = require("@lune/serde")
local H = require("../tests/harness")

local Config = H.require("Config")
local Catalog = H.require("Progression.Catalog")

-- Case cues that can drop, by rarity (an Index row is complete once each one is owned).
local caseCues = {}
for _, cue in Catalog.list() do
	if cue.Group == "Case" and not cue.Vaulted then
		caseCues[cue.Rarity] = (caseCues[cue.Rarity] or 0) + 1
	end
end

local out = {
	_note = "Generated by tools/export_economy.luau from src/shared/Config.luau. Do not edit.",
	Economy = Config.Economy, -- match money, boosts, UseDifficultyMultiplier
	DifficultyMoney = Config.Difficulty.MoneyMultiplier,
	Cases = {
		Order = Config.Cases.Order,
		Rarities = Config.Cases.Rarities,
		OddsTotal = Config.Cases.OddsTotal,
		List = Config.Cases.List, -- each case's Odds and Timer
		Drop = Config.Cases.Drop, -- Case Drop weights, pity, the first win's case
		SellBack = Config.Cases.SellBack,
	},
	CaseCues = caseCues,
	Daily = {
		Streak = Config.Daily.Streak,
		FreezePerWeek = Config.Daily.FreezePerWeek,
		TrackDays = Config.Daily.TrackDays,
		Track = Config.Daily.Track,
		Playtime = Config.Daily.Playtime,
		Codes = Config.Daily.Codes,
	},
	Social = {
		GroupReward = Config.Social.GroupReward,
		InviteCase = Config.Social.InviteCase,
		InvitesPerMonth = Config.Social.InvitesPerMonth,
	},
	Shop = {
		Mystery = Config.Shop.Mystery,
		Restock = Config.Shop.Restock,
		Skip = Config.Shop.Skip,
		StarterMoney = Config.Shop.StarterMoney,
	},
	Packs = {}, -- filled below: the Robux money packs in shop order
	Ranks = {
		Tiers = Config.Ranks.Tiers,
		DivisionXp = Config.Ranks.DivisionXp,
		BaseXp = Config.Ranks.BaseXp,
		ModeXp = Config.Ranks.ModeXp,
		Gap = Config.Ranks.Gap,
		PcXp = Config.Ranks.PcXp,
		Boosts = Config.Ranks.Boosts,
		Unlocks = Config.Ranks.Unlocks,
		Rewards = Config.Ranks.Rewards,
	},
	Index = Config.Index, -- row money and finder's money
	Ults = { Earn = Config.Ults.Earn }, -- the ability spin's money price
}
for _, key in Config.Products.PackOrder do
	local row = Config.Products.List[key]
	table.insert(out.Packs, { Key = key, Robux = row.Robux, Money = row.Money })
end

fs.writeFile("tools/economy_config.json", serde.encode("json", out, true))
print("wrote tools/economy_config.json")
